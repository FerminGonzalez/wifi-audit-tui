[Desktop Entry]
Version=1.0
Type=Application
Name=WiFi Audit TUI
Comment=Auditoría Wi-Fi autorizada sobre la suite aircrack-ng
Exec=bash -c 'cd "$HOME/wifi-audit-tui" && exec ./run.sh'
Icon=wifi-audit-tui
Terminal=true
Categories=Security;System;Network;
